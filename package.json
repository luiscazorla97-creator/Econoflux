{
  "name": "econoflux",
  "version": "1.0.0",
  "description": "EconoFlux \u2014 bilingual static cryptocurrency publication",
  "main": "index.js",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:production": "ASTRO_TELEMETRY_DISABLED=1 SITE_MODE=production astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "test": "playwright test",
    "build:review": "ASTRO_TELEMETRY_DISABLED=1 SITE_MODE=preview astro build && node scripts/verify-build.mjs",
    "news:fetch": "python3 scripts/server/cryptonews.py --live",
    "test:news": "python3 -m unittest discover -s scripts/server -p \"test_*.py\"",
    "test:editorial": "vitest run --config automation/vitest.config.ts",
    "check:editorial": "tsc -p automation/tsconfig.json",
    "editorial:dry-run": "CLOUDFLARE_SEND_METRICS=false wrangler deploy --config automation/wrangler.closed.jsonc --dry-run",
    "editorial:import-draft": "python3 scripts/server/import_editorial_draft.py",
    "test:editorial-build": "npm run build:review && npm run test:dynamic",
    "test:dynamic": "node scripts/verify-dynamic-site.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luiscazorla97-creator/Econoflux.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/luiscazorla97-creator/Econoflux/issues"
  },
  "homepage": "https://github.com/luiscazorla97-creator/Econoflux#readme",
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "astro": "^5.18.2",
    "jose": "^6.2.15"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261101.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
