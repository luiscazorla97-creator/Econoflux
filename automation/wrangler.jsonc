{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "econoflux-editorial",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "econoflux-editorial",
      "database_id": "70a247b6-ec51-46dc-a644-a8f9c40c1204",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SITE_URL": "https://econoflux.pages.dev",
    "GITHUB_REPOSITORY": "luiscazorla97-creator/Econoflux",
    "GITHUB_BRANCH": "main",
    "PAGES_PROJECT": "econoflux",
    "AI_MODEL": "gpt-5-mini",
    "ADMIN_EMAILS": "luiscazorla97@gmail.com",
    "CF_ACCESS_TEAM_DOMAIN": "econoflux-luiscazorla97.cloudflareaccess.com",
    "CF_ACCESS_AUD": "aef3c8db4b93d949903fd9d3a41ba1b208a155256335e93e14aab41ddd7d738c",
    "ADMIN_DISABLED": "true"
  }
}
