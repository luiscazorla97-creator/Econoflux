---
import "../styles/global.css";
import { reportingUrl } from "../lib/confirmation";
import { academyName, academyUrl } from "../content/academy";
import PriceTicker from "../components/PriceTicker.astro";

import { copy, type Lang } from "../lib/i18n";

import { isIndexableSite, SITE_ORIGIN } from "../lib/site";
import {
  schemaJSON,
  breadcrumbStructuredData,
  websiteStructuredData,
  type Breadcrumb,
} from "../lib/structured-data";

interface Props {
  canonicalPath?: string;
  articleId?: string;
  revision?: number;
  lang: Lang;
  title: string;
  description: string;
  alternate?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  schema?: Record<string, unknown>;
  noindex?: boolean;
  breadcrumbs?: Breadcrumb[];
  previousPath?: string;
  nextPath?: string;
}
const {
  lang,
  title,
  description,
  alternate,
  image = "/images/hero.webp",
  imageAlt = title,
  imageWidth = 1536,
  imageHeight = 1024,
  schema,
  noindex = false,
  articleId,
  canonicalPath,
  revision,
  breadcrumbs,
  previousPath,
  nextPath,
} = Astro.props;

const t = copy[lang];
const other = lang === "en" ? "es" : "en";
const preview = !isIndexableSite(Astro.url, Astro.locals);
const canonical = new URL(canonicalPath || Astro.url.pathname, SITE_ORIGIN)
  .href;
const currentPath = canonicalPath || Astro.url.pathname;

const nav = [
  ["news", t.news],
  ["bitcoin", "Bitcoin"],
  ["ethereum", "Ethereum"],
  ["markets", t.markets],
  ["learn", t.learn],
  ["academy", academyName(lang)],
  ["rumors", lang === "en" ? "Rumors & Leaks" : "Rumores y filtraciones"],
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    {!preview && (
      <script
        is:inline
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1382859681401211"
        crossorigin="anonymous"
      ></script>
    )}
    <title>{title} | EconoFlux</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={
        preview || noindex
          ? "noindex, nofollow"
          : "index, follow, max-image-preview:large"
      }
    />
    <link rel="canonical" href={canonical} />
    {previousPath && (
      <link rel="prev" href={new URL(previousPath, SITE_ORIGIN).href} />
    )}
    {nextPath && <link rel="next" href={new URL(nextPath, SITE_ORIGIN).href} />}
    <link rel="alternate" hreflang={lang} href={canonical} />
    {alternate && (
      <link
        rel="alternate"
        hreflang={other}
        href={new URL(alternate, SITE_ORIGIN).href}
      />
    )}
    <link
      rel="alternate"
      hreflang="x-default"
      href={
        new URL(
          lang === "en"
            ? canonicalPath || Astro.url.pathname
            : alternate || "/en/",
          SITE_ORIGIN,
        ).href
      }
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {articleId && <meta name="econoflux-article-id" content={articleId} />}
    {revision !== undefined && (
      <meta name="econoflux-revision" content={String(revision)} />
    )}
    <meta name="theme-color" content="#0d0f12" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="EconoFlux" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={schema ? "article" : "website"} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_ES"} />
    <meta property="og:image" content={new URL(image, SITE_ORIGIN).href} />
    <meta
      property="og:image:secure_url"
      content={new URL(image, SITE_ORIGIN).href}
    />
    <meta
      property="og:image:type"
      content={
        image.endsWith(".jpg")
          ? "image/jpeg"
          : image.endsWith(".png")
            ? "image/png"
            : image.endsWith(".svg")
              ? "image/svg+xml"
              : "image/webp"
      }
    />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    {schema?.datePublished && (
      <meta
        property="article:published_time"
        content={String(schema.datePublished)}
      />
    )}
    {schema?.dateModified && (
      <meta
        property="article:modified_time"
        content={String(schema.dateModified)}
      />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, SITE_ORIGIN).href} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {schema && (
      <script type="application/ld+json" set:html={schemaJSON(schema)} />
    )}
    {breadcrumbs && (
      <script
        type="application/ld+json"
        set:html={schemaJSON(breadcrumbStructuredData(breadcrumbs))}
      />
    )}
    {Astro.url.pathname === `/${lang}/` && (
      <script
        type="application/ld+json"
        set:html={schemaJSON(websiteStructuredData(lang))}
      />
    )}
  </head>
  <body>
    <a class="skip" href="#main">
      {lang === "en" ? "Skip to content" : "Ir al contenido"}
    </a>
    <header class="header">
      <div class="shell header-inner">
        <a class="brand" href={`/${lang}/`} aria-label="EconoFlux">
          <img src="/favicon.svg" alt="" width="43" height="43" />
          <span>EconoFlux</span>
        </a>
        <nav class="desktop-nav" aria-label={t.categories}>
          {nav.map(([id, label]) => (
            <a
              href={
                id === "rumors"
                  ? reportingUrl(lang)
                  : id === "academy"
                    ? academyUrl(lang)
                    : `/${lang}/category/${id}/`
              }
              aria-current={
                (
                  id === "rumors"
                    ? Astro.url.pathname.startsWith(reportingUrl(lang))
                    : id === "academy"
                      ? Astro.url.pathname.startsWith(academyUrl(lang))
                      : Astro.url.pathname.includes(`/category/${id}/`)
                )
                  ? "page"
                  : undefined
              }
            >
              {label}
            </a>
          ))}
        </nav>
        <div class="header-actions">
          <a
            class="search-icon"
            href={`/${lang}/search/`}
            aria-label={t.search}
          >
            <svg
              viewBox="0 0 24 24"
              width="23"
              height="23"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
            >
              <circle cx="10.5" cy="10.5" r="7.5" />
              <path d="m16 16 6 6" />
            </svg>
          </a>
          <div class="languages">
            <a
              lang="en"
              href={lang === "en" ? currentPath : alternate || "/en/"}
              class:list={{ active: lang === "en" }}
            >
              EN
            </a>
            <a
              lang="es"
              href={lang === "es" ? currentPath : alternate || "/es/"}
              class:list={{ active: lang === "es" }}
            >
              ES
            </a>
          </div>
          <button
            class="menu-toggle"
            aria-label={t.menu}
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
      <nav id="mobile-nav" hidden aria-label={t.menu}>
        {nav.map(([id, label]) => (
          <a
            href={
              id === "rumors"
                ? reportingUrl(lang)
                : id === "academy"
                  ? academyUrl(lang)
                  : `/${lang}/category/${id}/`
            }
          >
            {label}
          </a>
        ))}
      </nav>
    </header>
    <PriceTicker lang={lang} />
    <main id="main">
      <slot />
    </main>
    <footer class="footer shell">
      <div class="footer-top">
        <div>
          <a class="brand" href={`/${lang}/`}>
            <img src="/favicon.svg" alt="" width="39" height="39" />
            <span>EconoFlux</span>
          </a>
          <p>{t.footer}</p>
        </div>
        <nav aria-label={t.about}>
          {["about", "editorial", "contact", "privacy", "terms"].map((id) => (
            <a href={`/${lang}/${id}/`}>{t[id as keyof typeof t]}</a>
          ))}
          {[
            [
              "verification",
              lang === "en" ? "How we verify" : "Cómo verificamos",
            ],
            [
              "methodology",
              lang === "en" ? "Sources & methodology" : "Fuentes y metodología",
            ],
            [
              "corrections",
              lang === "en" ? "Corrections policy" : "Política de correcciones",
            ],
            [
              "education",
              lang === "en" ? "Educational notice" : "Aviso educativo",
            ],
          ].map(([id, label]) => (
            <a href={`/${lang}/${id}/`}>{label}</a>
          ))}
          <a href={academyUrl(lang)}>{academyName(lang)}</a>
        </nav>
      </div>
      <div class="footer-bottom">
        <span>
          © {new Date().getUTCFullYear()} EconoFlux. {t.copyright}
        </span>
        <span>{t.disclaimer}</span>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector<HTMLElement>("#mobile-nav");
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") !== "true";
        toggle.setAttribute("aria-expanded", String(open));
        if (nav) nav.hidden = !open;
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && nav && !nav.hidden) {
          nav.hidden = true;
          toggle?.setAttribute("aria-expanded", "false");
          toggle?.focus();
        }
      });
    </script>
  </body>
</html>
