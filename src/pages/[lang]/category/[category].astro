---
import { publicArticles } from "../../../lib/live-content";
import Layout from "../../../layouts/Layout.astro";
import Card from "../../../components/Card.astro";
import { copy, categoryName, type Lang } from "../../../lib/i18n";

const lang = Astro.params.lang as Lang;
if (!["en", "es"].includes(lang))
  return new Response("Not found", { status: 404 });

const category = Astro.params.category!;
if (
  ![
    "news",
    "bitcoin",
    "ethereum",
    "altcoins",
    "defi",
    "markets",
    "learn",
  ].includes(category)
)
  return new Response("Not found", { status: 404 });
const pageNumber=Math.max(1,Math.floor(Number(Astro.url.searchParams.get("page"))||1));
const visibleArticles=await publicArticles(Astro.locals,{lang,category,page:pageNumber});
const t = copy[lang];
const title = categoryName(category, lang);
const items = visibleArticles.filter(
  (a) =>
    a.lang === lang &&
    (["news", "learn"].includes(category) || a.category === category),
);
---

<Layout
  lang={lang}
  title={title}
  description={`${title} — ${t.intro}`}
  alternate={`/${lang === "en" ? "es" : "en"}/category/${category}/`}
>
  <section class="shell page-section">
    <nav class="breadcrumb">
      <a href={`/${lang}/`}>{t.home}</a>
      <span>/</span>
      <span>{title}</span>
    </nav>
    <p class="eyebrow">EconoFlux / {t.categories}</p>
    <h1>{title}</h1>
    <p class="page-intro">{category === "markets" ? t.unavailable : t.intro}</p>
    <div class="topic-links">
      {["news", "bitcoin", "ethereum", "altcoins", "defi", "learn"].map((c) => (
        <a
          aria-current={c === category ? "page" : undefined}
          href={`/${lang}/category/${c}/`}
        >
          {categoryName(c, lang)}
        </a>
      ))}
    </div>
    {items.length ? (
      <div class="cards">
        {items.map((article) => (
          <Card article={article} />
        ))}
      </div>
    ) : (
      <div class="empty">
        <p>{t.noCategory}</p>
        <a class="text-link" href={`/${lang}/category/learn/`}>
          {t.learn} →
        </a>
      </div>
    )}
    <nav class="archive-nav" aria-label={t.back}>
      <a href={`/${lang}/category/news/`}>← {t.showAll}</a>
      {pageNumber>1&&<a href={`?page=${pageNumber-1}`}>{lang==="es"?"Más recientes":"Newer stories"}</a>}
      {items.filter(a=>!a.demo).length>=12&&<a href={`?page=${pageNumber+1}`}>{lang==="es"?"Anteriores":"Older stories"} →</a>}
      <span>
        {items.length} {lang === "en" ? "stories" : "artículos"}
      </span>
    </nav>
  </section>
</Layout>
