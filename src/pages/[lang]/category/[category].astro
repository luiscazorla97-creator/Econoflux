---
import { publicArticles, publicArticleCount } from "../../../lib/live-content";
import { archivePage, pagePath } from "../../../lib/pagination";
import Layout from "../../../layouts/Layout.astro";
import MarketOverview from "../../../components/MarketOverview.astro";
import Card from "../../../components/Card.astro";
import { copy, categoryName, type Lang } from "../../../lib/i18n";
import { categoryIntro } from "../../../lib/category-copy";
import { academyUrl } from "../../../content/academy";

const lang = Astro.params.lang as Lang;
if (!["en", "es"].includes(lang))
  return new Response("Not found", { status: 404 });

const category = Astro.params.category!;
if (
  ![
    "news",
    "bitcoin",
    "ethereum",
    "altcoins",
    "defi",
    "markets",
    "learn",
  ].includes(category)
)
  return new Response("Not found", { status: 404 });
const pageNumber = archivePage(Astro.url.searchParams.get("page"));
const total = await publicArticleCount(Astro.locals, { lang, category });
if (pageNumber > 1 && (pageNumber - 1) * 12 >= total)
  return new Response("Not found", { status: 404 });
const base = `/${lang}/category/${category}/`;
const hasNext = pageNumber * 12 < total;
const visibleArticles = await publicArticles(Astro.locals, {
  lang,
  category,
  page: pageNumber,
});
const t = copy[lang];
const title = categoryName(category, lang);
const items = visibleArticles.filter(
  (a) =>
    a.lang === lang &&
    (["news", "learn"].includes(category) || a.category === category),
);
---

<Layout
  lang={lang}
  title={
    title +
    (pageNumber > 1
      ? ` · ${lang === "en" ? "Page" : "Página"} ${pageNumber}`
      : "")
  }
  description={`${categoryIntro(category, lang)}${pageNumber > 1 ? ` ${lang === "en" ? "Page" : "Página"} ${pageNumber}.` : ""}`}
  canonicalPath={pagePath(base, pageNumber)}
  alternate={pagePath(
    `/${lang === "en" ? "es" : "en"}/category/${category}/`,
    pageNumber,
  )}
  previousPath={pageNumber > 1 ? pagePath(base, pageNumber - 1) : undefined}
  nextPath={hasNext ? pagePath(base, pageNumber + 1) : undefined}
  breadcrumbs={[
    { name: t.home, path: `/${lang}/` },
    { name: title, path: base },
  ]}
>
  <section class="shell page-section">
    <nav class="breadcrumb">
      <a href={`/${lang}/`}>{t.home}</a>
      <span>/</span>
      <span>{title}</span>
    </nav>
    <p class="eyebrow">EconoFlux / {t.categories}</p>
    <h1>{title}</h1>
    <p class="page-intro">{categoryIntro(category, lang)}</p>
    {category === "markets" && <MarketOverview lang={lang} />}
    <div class="topic-links">
      {["news", "bitcoin", "ethereum", "altcoins", "defi", "learn"].map((c) => (
        <a
          aria-current={c === category ? "page" : undefined}
          href={c === "learn" ? academyUrl(lang) : `/${lang}/category/${c}/`}
        >
          {categoryName(c, lang)}
        </a>
      ))}
    </div>
    {items.length ? (
      <div class="cards">
        {items.map((article) => (
          <Card article={article} />
        ))}
      </div>
    ) : (
      <div class="empty">
        <p>{t.noCategory}</p>
        <a class="text-link" href={academyUrl(lang)}>
          {t.learn} →
        </a>
      </div>
    )}
    <nav class="archive-nav" aria-label={t.back}>
      <a href={`/${lang}/category/news/`}>← {t.showAll}</a>
      {pageNumber > 1 && (
        <a href={pagePath(base, pageNumber - 1)}>
          {lang === "es" ? "Más recientes" : "Newer stories"}
        </a>
      )}
      {hasNext && (
        <a href={pagePath(base, pageNumber + 1)}>
          {lang === "es" ? "Anteriores" : "Older stories"} →
        </a>
      )}
      <span>
        {items.length} {lang === "en" ? "stories" : "artículos"}
      </span>
    </nav>
  </section>
</Layout>
