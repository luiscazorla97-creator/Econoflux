---
import { publicArticles, relatedArticles } from "../../../lib/live-content";
import { SITE_ORIGIN } from "../../../lib/site";
import Layout from "../../../layouts/Layout.astro";
import Card from "../../../components/Card.astro";
import Share from "../../../components/Share.astro";
import Ad from "../../../components/Ad.astro";
import { copy } from "../../../lib/i18n";
import {
  articleUrl,
  readingTime,
  articleWordCount,
} from "../../../content/articles";

const visibleArticles = await publicArticles(Astro.locals, {
  lang: Astro.params.lang,
  slug: Astro.params.slug,
});
const a = visibleArticles.find(
  (item) => item.lang === Astro.params.lang && item.slug === Astro.params.slug,
);
if (!a) return new Response("Not found", { status: 404 });
const t = copy[a.lang];
const translation = visibleArticles.find(
  (b) => b.translationId === a.translationId && b.lang !== a.lang,
);
const related = a.demo
  ? visibleArticles
      .filter((b) => b.lang === a.lang && b.id !== a.id)
      .slice(0, 3)
  : await relatedArticles(Astro.locals, a);

const schema = {
  "@context": "https://schema.org",
  "@type": ["analysis", "explainer"].includes(a.format || "")
    ? "Article"
    : "NewsArticle",
  "@id": new URL(articleUrl(a) + "#article", SITE_ORIGIN).href,
  headline: a.title,
  description: a.summary,
  inLanguage: a.lang,
  datePublished: a.publishedAt,
  ...(a.updatedAt ? { dateModified: a.updatedAt } : {}),
  author: { "@type": "Organization", name: a.author },
  publisher: { "@type": "Organization", name: "EconoFlux", url: SITE_ORIGIN },
  image: {
    "@type": "ImageObject",
    url: new URL(a.image.src, SITE_ORIGIN).href,
    caption: a.image.credit,
  },
  articleSection: a.category,
  keywords: a.seo?.primaryKeyword || a.tags.join(", "),
  wordCount: articleWordCount(a),
  citation: a.sources.map((s) => s.url),
  mainEntityOfPage: new URL(articleUrl(a), SITE_ORIGIN).href,
};
---

<Layout
  lang={a.lang}
  articleId={a.translationId}
  revision={a.editorialRevision}
  title={a.seoTitle || a.title}
  description={a.seoDescription || a.summary}
  alternate={translation ? articleUrl(translation) : undefined}
  image={a.image.socialSrc || a.image.src}
  imageAlt={a.image.alt}
  imageWidth={a.image.socialWidth || a.image.width || 1536}
  imageHeight={a.image.socialHeight || a.image.height || 1024}
  schema={schema}
  noindex={a.demo}
>
  <article class="shell article-page">
    <nav class="breadcrumb">
      <a href={`/${a.lang}/`}>{t.home}</a>
      <span>/</span>
      <a href={`/${a.lang}/category/${a.category}/`}>{a.category}</a>
    </nav>
    {a.demo && <p class="demo-notice">{t.demoNote}</p>}
    <header class="article-heading">
      <p class="eyebrow">
        {a.category} / {readingTime(a)} {t.read}
      </p>
      <h1>{a.title}</h1>
      <p class="standfirst">{a.summary}</p>
      <div class="byline">
        <span class="author-avatar">EF</span>
        <div>
          <strong>{a.author}</strong>
          <span>
            {t.published}:{" "}
            <time datetime={a.publishedAt}>
              {new Date(
                a.publishedAt.includes("T")
                  ? a.publishedAt
                  : a.publishedAt + "T12:00:00Z",
              ).toLocaleDateString(a.lang, {
                year: "numeric",
                month: "long",
                day: "numeric",
                timeZone: "UTC",
              })}
            </time>
            {a.updatedAt && (
              <>
                {" "}
                · {t.updated}:{" "}
                <time datetime={a.updatedAt}>
                  {new Date(a.updatedAt).toLocaleDateString(a.lang, {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                    timeZone: "UTC",
                  })}
                </time>
              </>
            )}
          </span>
        </div>
      </div>
      <Share
        lang={a.lang}
        title={a.title}
        summary={a.summary}
        url={new URL(articleUrl(a), SITE_ORIGIN).href}
      />
    </header>
    <figure class="article-figure">
      <img
        src={a.image.src}
        srcset={a.image.srcSet}
        sizes="(max-width: 900px) 100vw, 900px"
        alt={a.image.alt}
        width={a.image.width || 1536}
        height={a.image.height || 1024}
        fetchpriority="high"
      />
      <figcaption>
        {a.image.credit}
        {a.image.sourceUrl && (
          <>
            {" "}
            ·{" "}
            <a
              href={a.image.sourceUrl}
              rel="noopener noreferrer"
              target="_blank"
            >
              {a.image.license || t.sources}
            </a>
          </>
        )}
      </figcaption>
    </figure>
    <div class="article-layout">
      <aside class="article-aside">
        <nav aria-label={t.contents}>
          <p class="eyebrow">{t.contents}</p>
          {a.sections.map((s) => (
            <a href={`#${s.id}`}>{s.title}</a>
          ))}
        </nav>
        <Ad lang={a.lang} placement="sidebar" />
      </aside>
      <div class="prose">
        {a.sections.map((s, i) => (
          <section id={s.id}>
            <h2>{s.title}</h2>
            {s.text.map((p) => (
              <p>{p}</p>
            ))}
            {s.subheading && <h3>{s.subheading}</h3>}
            {s.list && (
              <ul>
                {s.list.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            )}
            {s.table && (
              <div
                class="table-scroll"
                tabindex="0"
                role="region"
                aria-label={s.title}
              >
                <table>
                  <thead>
                    <tr>
                      {s.table.headings.map((h) => (
                        <th scope="col">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {s.table.rows.map((row) => (
                      <tr>
                        {row.map((cell) => (
                          <td>{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {i === 1 && <Ad lang={a.lang} placement="inline" />}
          </section>
        ))}
        <section class="sources">
          <h2>{t.sources}</h2>
          <ul>
            {a.sources.map((s) => (
              <li>
                <a href={s.url} rel="noopener noreferrer" target="_blank">
                  {s.label} ⟶
                </a>
              </li>
            ))}
          </ul>
        </section>
        <p class="article-disclaimer">{t.disclaimer}</p>
        <Share
          lang={a.lang}
          title={a.title}
          summary={a.summary}
          url={new URL(articleUrl(a), SITE_ORIGIN).href}
        />
        {translation && (
          <a class="text-link" href={articleUrl(translation)}>
            {t.translation} →
          </a>
        )}
      </div>
    </div>
  </article>
  {related.length > 0 && (
    <section class="shell section">
      <h2>{t.related}</h2>
      <div class="cards related">
        {related.map((article) => (
          <Card article={article} />
        ))}
      </div>
    </section>
  )}
</Layout>
