---
import { publicArticles } from "../../../lib/live-content";
import Layout from "../../../layouts/Layout.astro";
import Card from "../../../components/Card.astro";
import Ad from "../../../components/Ad.astro";
import { copy } from "../../../lib/i18n";
import { articleUrl, readingTime } from "../../../content/articles";

const visibleArticles = await publicArticles(Astro.locals,{lang:Astro.params.lang,slug:Astro.params.slug});
const a = visibleArticles.find(
  (item) => item.lang === Astro.params.lang && item.slug === Astro.params.slug,
);
if (!a) return new Response("Not found", { status: 404 });
const t = copy[a.lang];
const translation = visibleArticles.find(
  (b) => b.translationId === a.translationId && b.lang !== a.lang,
);
const related = visibleArticles.filter(
  (b) => b.lang === a.lang && b.id !== a.id,
);

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: a.title,
  description: a.summary,
  inLanguage: a.lang,
  datePublished: a.publishedAt,
  ...(a.updatedAt ? { dateModified: a.updatedAt } : {}),
  author: { "@type": "Organization", name: a.author },
  image: new URL(a.image.src, Astro.site).href,
  mainEntityOfPage: new URL(articleUrl(a), Astro.site).href,
};
---

<Layout
  lang={a.lang}
  articleId={a.translationId}
  revision={a.editorialRevision}
  title={a.seoTitle || a.title}
  description={a.seoDescription || a.summary}
  alternate={translation ? articleUrl(translation) : undefined}
  image={a.image.src}
  schema={schema}
  noindex={a.demo}
>
  <article class="shell article-page">
    <nav class="breadcrumb">
      <a href={`/${a.lang}/`}>{t.home}</a>
      <span>/</span>
      <a href={`/${a.lang}/category/${a.category}/`}>{a.category}</a>
    </nav>
    {a.demo && <p class="demo-notice">{t.demoNote}</p>}
    <header class="article-heading">
      <p class="eyebrow">
        {a.category} / {readingTime(a)} {t.read}
      </p>
      <h1>{a.title}</h1>
      <p class="standfirst">{a.summary}</p>
      <div class="byline">
        <span class="author-avatar">EF</span>
        <div>
          <strong>{a.author}</strong>
          <span>
            {t.published}:{" "}
            <time datetime={a.publishedAt}>
              {new Date(
                a.publishedAt.includes("T")
                  ? a.publishedAt
                  : a.publishedAt + "T12:00:00Z",
              ).toLocaleDateString(a.lang, {
                year: "numeric",
                month: "long",
                day: "numeric",
                timeZone: "UTC",
              })}
            </time>
            {a.updatedAt && (
              <>
                {" "}
                · {t.updated}: <time datetime={a.updatedAt}>{a.updatedAt}</time>
              </>
            )}
          </span>
        </div>
        <button class="share" data-copied={t.copied} data-failed={t.copyFail}>
          {t.share} ⟶
        </button>
        <span class="share-status" role="status"></span>
      </div>
    </header>
    <figure class="article-figure">
      <img
        src={a.image.src}
        alt={a.image.alt}
        width="1200"
        height="750"
        fetchpriority="high"
      />
      <figcaption>{t.credit}</figcaption>
    </figure>
    <div class="article-layout">
      <aside class="article-aside">
        <nav aria-label={t.contents}>
          <p class="eyebrow">{t.contents}</p>
          {a.sections.map((s) => (
            <a href={`#${s.id}`}>{s.title}</a>
          ))}
        </nav>
        <Ad lang={a.lang} placement="sidebar" />
      </aside>
      <div class="prose">
        {a.sections.map((s, i) => (
          <section id={s.id}>
            <h2>{s.title}</h2>
            {s.text.map((p) => (
              <p>{p}</p>
            ))}
            {s.subheading && <h3>{s.subheading}</h3>}
            {s.list && (
              <ul>
                {s.list.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            )}
            {s.table && (
              <div
                class="table-scroll"
                tabindex="0"
                role="region"
                aria-label={s.title}
              >
                <table>
                  <thead>
                    <tr>
                      {s.table.headings.map((h) => (
                        <th scope="col">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {s.table.rows.map((row) => (
                      <tr>
                        {row.map((cell) => (
                          <td>{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {i === 1 && <Ad lang={a.lang} placement="inline" />}
          </section>
        ))}
        <section class="sources">
          <h2>{t.sources}</h2>
          <ul>
            {a.sources.map((s) => (
              <li>
                <a href={s.url} rel="noopener noreferrer" target="_blank">
                  {s.label} ⟶
                </a>
              </li>
            ))}
          </ul>
        </section>
        <p class="article-disclaimer">{t.disclaimer}</p>
        {translation && (
          <a class="text-link" href={articleUrl(translation)}>
            {t.translation} →
          </a>
        )}
      </div>
    </div>
  </article>
  <section class="shell section">
    <h2>{t.related}</h2>
    <div class="cards related">
      {related.map((article) => (
        <Card article={article} />
      ))}
    </div>
  </section>
</Layout>
<script>
  document
    .querySelector<HTMLButtonElement>(".share")
    ?.addEventListener("click", async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      const status = document.querySelector(".share-status");
      try {
        await navigator.clipboard.writeText(location.href);
        if (status) status.textContent = b.dataset.copied || "";
      } catch {
        if (status) status.textContent = b.dataset.failed || "";
      }
    });
</script>
