---
import Layout from "../../layouts/Layout.astro";
import { pages } from "../../content/pages";
import { langs, type Lang } from "../../lib/i18n";

const lang = Astro.params.lang as Lang;
const page = Astro.params.page as keyof typeof pages.en;
const data =
  langs.includes(lang) && Object.hasOwn(pages[lang], page)
    ? pages[lang][page]
    : null;
if (!data) return new Response("Not found", { status: 404 });
---

<Layout
  lang={lang}
  title={data.title}
  description={data.intro}
  alternate={`/${lang === "en" ? "es" : "en"}/${page}/`}
>
  <section class="shell page-section legal-page">
    <p class="eyebrow">EconoFlux</p>
    <h1>{data.title}</h1>
    <p class="page-intro">{data.intro}</p>
    {data.sections.map(([h, p]) => (
      <section>
        <h2>{h}</h2>
        <p>
          {p.split("luterapps@gmail.com").map((part, index) => (
            <>
              {index > 0 && (
                <a class="text-link" href="mailto:luterapps@gmail.com">
                  luterapps@gmail.com
                </a>
              )}
              {part}
            </>
          ))}
        </p>
      </section>
    ))}
  </section>
</Layout>
