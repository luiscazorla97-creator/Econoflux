---
import Layout from "../../layouts/Layout.astro";
import { pages } from "../../content/pages";
import { langs, type Lang } from "../../lib/i18n";
import { policyIds, policyPages } from "../../content/policies";

const lang = Astro.params.lang as Lang;
const page = Astro.params.page as keyof typeof pages.en;
const data =
  langs.includes(lang) && Object.hasOwn(pages[lang], page)
    ? pages[lang][page]
    : null;
if (!data) return new Response("Not found", { status: 404 });
const policy = Object.hasOwn(policyPages[lang], page)
  ? policyPages[lang][page as keyof typeof policyPages.en]
  : undefined;
const links = policy?.links ?? [];
const reviewedAt = policy?.reviewedAt;
---

<Layout
  lang={lang}
  title={data.title}
  description={data.intro}
  alternate={`/${lang === "en" ? "es" : "en"}/${page}/`}
>
  <section class="shell page-section legal-page">
    <p class="eyebrow">EconoFlux</p>
    <h1>{data.title}</h1>
    <p class="page-intro">{data.intro}</p>
    {reviewedAt && (
      <p>
        {lang === "en"
          ? "Text last updated: "
          : "Última actualización del texto: "}
        <time datetime={reviewedAt}>
          {new Date(reviewedAt + "T12:00:00Z").toLocaleDateString(lang, {
            year: "numeric",
            month: "long",
            day: "numeric",
            timeZone: "UTC",
          })}
        </time>
      </p>
    )}
    {data.sections.map(([h, p]) => (
      <section>
        <h2>{h}</h2>
        <p>
          {p.split("luterapps@gmail.com").map((part, index) => (
            <>
              {index > 0 && (
                <a class="text-link" href="mailto:luterapps@gmail.com">
                  luterapps@gmail.com
                </a>
              )}
              {part}
            </>
          ))}
        </p>
      </section>
    ))}
    {links.length > 0 && (
      <section>
        <h2>
          {lang === "en"
            ? "Provider information and privacy choices"
            : "Información de proveedores y opciones de privacidad"}
        </h2>
        <ul>
          {links.map((link) => (
            <li>
              <a
                class="text-link"
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.label} ↗
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <nav
      aria-label={lang === "en" ? "Related policies" : "Políticas relacionadas"}
    >
      <h2>{lang === "en" ? "Related policies" : "Políticas relacionadas"}</h2>
      <ul>
        {policyIds
          .filter((id) => id !== page)
          .map((id) => (
            <li>
              <a class="text-link" href={`/${lang}/${id}/`}>
                {policyPages[lang][id].title}
              </a>
            </li>
          ))}
        <li>
          <a class="text-link" href={`/${lang}/education/`}>
            {lang === "en"
              ? "Financial and educational notice"
              : "Aviso financiero y educativo"}
          </a>
        </li>
        <li>
          <a class="text-link" href={`/${lang}/contact/`}>
            {lang === "en" ? "Contact" : "Contacto"}
          </a>
        </li>
      </ul>
    </nav>
  </section>
</Layout>
