---
import { publicGuides } from "../../lib/academy";
import {
  academyName,
  academyUrl,
  guideUrl,
  type Guide,
} from "../../content/academy";
import { publicArticles } from "../../lib/live-content";
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card.astro";
import Ad from "../../components/Ad.astro";
import { copy, type Lang } from "../../lib/i18n";
import { articleUrl } from "../../content/articles";

const lang = Astro.params.lang as Lang;
if (!["en", "es"].includes(lang))
  return new Response("Not found", { status: 404 });
const visibleArticles = await publicArticles(Astro.locals, { lang });
const t = copy[lang];
const items = visibleArticles.filter((a) => a.lang === lang);
const featured = items[0];
const academy = (await publicGuides(Astro.locals, { lang })).filter(
  (g) => g.lang === lang,
);
const guides = academy.length
  ? academy
  : items.filter((a) => a.format === "explainer" || a.tags.includes("learn"));
const readingList = (guides.length ? guides : items).slice(0, 3);
const readingUrl = (a: (typeof readingList)[number]) =>
  (a as Guide).kind === "guide" ? guideUrl(a as Guide) : articleUrl(a);
---

<Layout
  lang={lang}
  title={
    lang === "en"
      ? "Independent crypto news & perspectives"
      : "Noticias y perspectivas independientes sobre cripto"
  }
  description={t.intro}
  alternate={`/${lang === "en" ? "es" : "en"}/`}
>
  <section class="hero">
    <img
      class="hero-art"
      src="/images/hero.webp"
      srcset="/images/hero-768.webp 768w, /images/hero.webp 1536w"
      sizes="(max-width: 767px) 100vw, 76vw"
      alt={
        lang === "en"
          ? "Gold Bitcoin and dark glass Ethereum on a black marble pedestal"
          : "Bitcoin dorado y Ethereum de cristal oscuro sobre un pedestal de mármol negro"
      }
      width="1536"
      height="1024"
      fetchpriority="high"
    />
    <div class="hero-shade"></div>
    <div class="shell hero-content">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 class:list={{ spanish: lang === "es" }}>
        {t.hero.split("\n").map((line) => (
          <span>{line}</span>
        ))}
      </h1>
      <p class="hero-intro">{t.intro}</p>
      <a class="text-link" href="#latest">
        {t.explore}
        <span aria-hidden="true">⟶</span>
      </a>
    </div>
  </section>
  <section id="latest" class="shell section">
    <div class="section-heading">
      <h2>
        {t.latest}
        <span class="gold-dot">.</span>
      </h2>
      <div class="filters" role="group" aria-label={t.categories}>
        {["all", "bitcoin", "ethereum", "altcoins", "defi"].map((cat, i) => (
          <button data-filter={cat} aria-pressed={i === 0}>
            {cat === "all"
              ? t.all
              : cat === "defi"
                ? "DeFi"
                : cat.charAt(0).toUpperCase() + cat.slice(1)}
          </button>
        ))}
      </div>
    </div>
    <div class="cards" id="story-grid">
      {items.map((article) => (
        <Card article={article} />
      ))}
    </div>
    <p id="filter-empty" class="empty" hidden={items.length > 0}>
      {t.noCategory}
    </p>
    <nav
      class="archive-nav"
      aria-label={lang === "en" ? "News archive" : "Archivo de noticias"}
    >
      <a href={`/${lang}/category/news/`}>
        {lang === "en"
          ? "Browse all news and earlier stories"
          : "Ver todas las noticias y el archivo"}{" "}
        →
      </a>
    </nav>
    <Ad lang={lang} />
  </section>
  {featured && (
    <section class="shell focus-section">
      <a class="focus" href={articleUrl(featured)}>
        <div class="focus-image">
          <img
            src={featured.image.src}
            srcset={featured.image.srcSet}
            sizes="(max-width: 767px) 100vw, 50vw"
            alt={featured.image.alt}
            width="768"
            height="512"
            loading="lazy"
          />
        </div>
        <div class="focus-copy">
          <p class="eyebrow">
            {t.featured} /{" "}
            {featured.category === "defi" ? "DeFi" : featured.category}
          </p>
          <h2>{featured.title}</h2>
          <p>{featured.summary}</p>
          <span class="text-link">
            {t.readStory} <span>⟶</span>
          </span>
        </div>
      </a>
    </section>
  )}
  <section class="shell guides section">
    <div>
      <p class="eyebrow">{t.guideLabel}</p>
      <h2>
        {guides.length
          ? academy.length
            ? academyName(lang)
            : t.guides
          : lang === "es"
            ? "Claves para entender el mercado"
            : "Understand the market"}
      </h2>
      <p>
        {guides.length
          ? academy.length
            ? lang === "en"
              ? "Practical educational guides with official sources, clear explanations and risk awareness."
              : "Guías educativas prácticas con fuentes oficiales, explicaciones claras y riesgos identificados."
            : t.guideIntro
          : lang === "es"
            ? "Noticias con contexto, fuentes y explicaciones para seguir las finanzas digitales."
            : "Reporting with context, sources and explanations to follow digital finance."}
      </p>
      <a
        class="text-link"
        href={
          academy.length
            ? academyUrl(lang)
            : `/${lang}/category/${guides.length ? "learn" : "news"}/`
        }
      >
        {academy.length ? academyName(lang) : guides.length ? t.learn : t.news}{" "}
        <span>⟶</span>
      </a>
    </div>
    <div class="guide-list">
      {readingList.map((a, i) => (
        <a href={readingUrl(a)}>
          <span class="guide-number">0{i + 1}</span>
          <div>
            <small>{a.category}</small>
            <h3>{a.title}</h3>
          </div>
          <span aria-hidden="true">⟶</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      let count = 0;
      document
        .querySelectorAll<HTMLElement>("#story-grid .card")
        .forEach((c) => {
          c.hidden =
            b.dataset.filter !== "all" &&
            c.dataset.category !== b.dataset.filter;
          if (!c.hidden) count++;
        });
      const empty = document.querySelector<HTMLElement>("#filter-empty");
      if (empty) empty.hidden = count !== 0;
    }),
  );
</script>
