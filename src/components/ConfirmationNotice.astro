---
import { confirmationLabel, type Confirmation } from "../lib/confirmation";
import type { Lang } from "../lib/i18n";
const { confirmation: c, lang } = Astro.props as {
  confirmation?: Confirmation;
  lang: Lang;
};
const original = c?.initialReport || c?.originalReport;
---

<section
  class="confirmation-panel"
  aria-label={
    lang === "en" ? "Verification status" : "Estado de la información"
  }
  data-confirmation={c?.status || "confirmed"}
>
  <strong class="confirmation-badge" data-status={c?.status || "confirmed"}>
    {confirmationLabel(c, lang)}
  </strong>
  {c && (
    <>
      {c.originStatus &&
        c.originStatus !== "confirmed" &&
        c.status === "confirmed" && (
          <p>
            {lang === "en"
              ? "Update to an earlier unconfirmed report."
              : "Actualización de un reporte que antes estaba sin confirmar."}
          </p>
        )}
      <p>{c.explanation}</p>
      <div class="confirmation-facts">
        {c.confirmedFacts.length > 0 && (
          <div>
            <h2>
              {lang === "en" ? "What is established" : "Qué está respaldado"}
            </h2>
            <ul>
              {c.confirmedFacts.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          </div>
        )}
        {c.unconfirmedClaims.length > 0 && (
          <div>
            <h2>
              {lang === "en"
                ? "What remains unconfirmed"
                : "Qué sigue sin confirmar"}
            </h2>
            <ul>
              {c.unconfirmedClaims.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
      <a
        class="text-link"
        href={original!.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        {lang === "en" ? "Original report" : "Reporte original"} ·{" "}
        {original!.label} ↗
      </a>
      {original!.url !== c.originalReport.url && (
        <a
          class="text-link"
          href={c.originalReport.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {lang === "en" ? "Update source" : "Fuente de actualización"} ·{" "}
          {c.originalReport.label} ↗
        </a>
      )}
    </>
  )}
</section>
