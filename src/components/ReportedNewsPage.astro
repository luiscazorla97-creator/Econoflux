---
import Layout from "../layouts/Layout.astro";
import Card from "./Card.astro";
import { publicArticles } from "../lib/live-content";
import { pagePath } from "../lib/pagination";
import { reportingUrl, isReported } from "../lib/confirmation";
import type { Lang } from "../lib/i18n";
const { lang, page, total } = Astro.props as {
  lang: Lang;
  page: number;
  total: number;
};
const hasNext = page * 12 < total;
const base = reportingUrl(lang);
const articles = (
  await publicArticles(Astro.locals, { lang, category: "rumors", page })
).filter((a) => a.lang === lang && isReported(a.confirmation));
const title = lang === "en" ? "Rumors & Leaks" : "Rumores y filtraciones";
const description =
  lang === "en"
    ? "Identifiable reporting, clear attribution and an explicit distinction between established facts and claims awaiting confirmation."
    : "Reportes identificables, atribución clara y una distinción explícita entre hechos respaldados y afirmaciones pendientes de confirmación.";
---

<Layout
  lang={lang}
  title={
    title + (page > 1 ? ` · ${lang === "en" ? "Page" : "Página"} ${page}` : "")
  }
  description={description}
  alternate={
    reportingUrl(lang === "en" ? "es" : "en") +
    (page > 1 ? `?page=${page}` : "")
  }
  canonicalPath={reportingUrl(lang) + (page > 1 ? `?page=${page}` : "")}
  previousPath={page > 1 ? pagePath(base, page - 1) : undefined}
  nextPath={hasNext ? pagePath(base, page + 1) : undefined}
  breadcrumbs={[
    { name: "EconoFlux", path: `/${lang}/` },
    { name: title, path: base },
  ]}
>
  <section class="shell page-section">
    <nav class="breadcrumb">
      <a href={`/${lang}/`}>EconoFlux</a>
      <span>/</span>
      <span>{title}</span>
    </nav>
    <p class="eyebrow">
      {lang === "en" ? "ATTRIBUTION & CONTEXT" : "ATRIBUCIÓN Y CONTEXTO"}
    </p>
    <h1>{title}</h1>
    <p class="page-intro">{description}</p>
    <p class="reporting-intro">
      {lang === "en"
        ? "Rumor means an identifiable source has reported an unconfirmed claim. Leak means unofficial materials or information with identifiable provenance whose authenticity may remain unresolved. Repetition across outlets does not establish truth. Confirmations and denials update the same article and URL."
        : "Rumor significa que una fuente identificable publicó una afirmación aún sin confirmar. Filtración significa información o material no oficial con procedencia identificable cuya autenticidad puede seguir pendiente. La repetición entre medios no demuestra su veracidad. Las confirmaciones y los desmentidos actualizan el mismo artículo y su URL."}
    </p>
    {articles.length ? (
      <div class="cards">
        {articles.map((a) => (
          <Card article={a} />
        ))}
      </div>
    ) : (
      <p class="empty">
        {lang === "en"
          ? "No eligible reports are published here yet. Unverifiable claims are withheld."
          : "Todavía no hay reportes que hayan superado la revisión para esta sección. Las afirmaciones sin respaldo permanecen pendientes."}
      </p>
    )}
    <nav class="archive-nav">
      {page > 1 && (
        <a href={pagePath(base, page - 1)}>
          {lang === "en" ? "Newer" : "Más recientes"}
        </a>
      )}
      {hasNext && (
        <a href={pagePath(base, page + 1)}>
          {lang === "en" ? "Older" : "Anteriores"}
        </a>
      )}
      <a href={`/${lang}/category/news/`}>
        {lang === "en" ? "All news" : "Todas las noticias"}
      </a>
    </nav>
  </section>
</Layout>
