---
import { articleUrl, readingTime, type Article } from "../content/articles";

import { copy } from "../lib/i18n";

const {
  article: a,
  href,
  label,
} = Astro.props as { article: Article; href?: string; label?: string };
const t = copy[a.lang];
---

<article class="card" data-category={a.category}>
  <a href={href || articleUrl(a)} class="card-link">
    <div class="card-image">
      <img
        src={a.image.src}
        srcset={a.image.srcSet}
        sizes="(max-width: 767px) 100vw, (max-width: 1080px) 50vw, 33vw"
        alt={a.image.alt}
        width="768"
        height="480"
        loading="lazy"
      />
      <span class="image-arrow" aria-hidden="true">
        ⟶
      </span>
    </div>
    <div class="card-body">
      <div class="card-meta">
        <span>{label || a.category}</span>
        <span>
          {readingTime(a)} {t.read}
        </span>
      </div>
      <h3>{a.title}</h3>
      <p>{a.summary}</p>
      {a.demo && <span class="demo-label">{t.demo}</span>}
    </div>
  </a>
</article>
