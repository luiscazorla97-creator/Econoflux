---
import { marketSnapshot } from "../lib/market";
import type { Lang } from "../lib/i18n";
const { lang } = Astro.props as { lang: Lang };
const snapshot = await marketSnapshot(Astro.locals);
const quotes = snapshot?.value ? JSON.parse(snapshot.value) : [];
const stale =
  !!snapshot?.last_error ||
  quotes.some((q: any) => Date.now() - Date.parse(q.updatedAt) > 15 * 60000);
const symbols = ["BTC", "ETH", "SOL"];
const formatter = new Intl.NumberFormat(lang === "es" ? "es-ES" : "en-US", {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});
const updated = quotes.length
  ? quotes.reduce((a: any, b: any) => (a.updatedAt < b.updatedAt ? a : b))
      .updatedAt
  : null;
const delay =
  lang === "es"
    ? "Cotizaciones en USD. Hasta 15 min de retraso."
    : "USD quotes. Up to 15 min delayed.";
const detailId = `market-details-${lang}`;
const quoteInfo =
  delay +
  (updated
    ? " " +
      (lang === "es" ? "Actualización: " : "Updated: ") +
      new Date(updated).toLocaleString(lang, { timeZone: "UTC" }) +
      " UTC"
    : "");
---

<div
  class="ticker market-ticker"
  data-market
  data-lang={lang}
  data-stale={stale ? "true" : "false"}
>
  <div class="shell ticker-inner">
    <div
      class="market-quotes"
      role="group"
      aria-label={
        lang === "es"
          ? "Cotizaciones de criptomonedas en USD"
          : "Cryptocurrency quotes in USD"
      }
      tabindex="0"
    >
      {symbols.map((symbol) => {
        const q = quotes.find((q: any) => q.symbol === symbol);
        return (
          <span class="ticker-item" data-symbol={symbol} title={quoteInfo}>
            <span>{symbol} / USD</span>
            <b class="market-price">
              {q ? "$" + formatter.format(q.price) : "—"}
            </b>
            <span
              class:list={[
                "market-change",
                q?.change24h > 0
                  ? "positive"
                  : q?.change24h < 0
                    ? "negative"
                    : "",
              ]}
            >
              {q?.change24h !== null && q?.change24h !== undefined
                ? (q.change24h > 0 ? "+" : "") +
                  formatter.format(q.change24h) +
                  "% 24h"
                : "—"}
            </span>
          </span>
        );
      })}
    </div>
    <button
      type="button"
      class="market-info-toggle"
      data-market-toggle
      aria-controls={detailId}
      aria-expanded="false"
      aria-label={
        lang === "es"
          ? "Información y actualización de las cotizaciones"
          : "Quote information and update time"
      }
      title={
        lang === "es" ? "Información de las cotizaciones" : "Quote information"
      }
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        aria-hidden="true"
      >
        <circle cx="10" cy="10" r="8" />
        <path d="M10 9v6M10 5v1" stroke-width="1.5" />
      </svg>
    </button>
  </div>
  <div class="market-details" id={detailId} hidden>
    <span>{delay}</span>
    {updated ? (
      <span class="market-updated">
        {lang === "es" ? "Actualización: " : "Updated: "}
        <time datetime={updated}>
          {new Date(updated).toLocaleString(lang, {
            timeZone: "UTC",
            hour: "2-digit",
            minute: "2-digit",
            day: "2-digit",
            month: "short",
          })}{" "}
          UTC
        </time>
        {stale
          ? " · " + (lang === "es" ? "Último dato válido" : "Last valid data")
          : ""}
      </span>
    ) : (
      <span class="market-updated">
        {lang === "es" ? "Datos no disponibles" : "Data unavailable"}
      </span>
    )}
  </div>
</div>
<script>
  for (const el of document.querySelectorAll<HTMLElement>("[data-market]")) {
    const lang = el.dataset.lang === "es" ? "es" : "en";
    const formatter = new Intl.NumberFormat(lang === "es" ? "es-ES" : "en-US", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });
    const toggle = el.querySelector<HTMLButtonElement>("[data-market-toggle]")!;
    const details = el.querySelector<HTMLElement>(".market-details")!;
    const close = () => {
      details.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
    };
    toggle.addEventListener("click", () => {
      details.hidden = !details.hidden;
      toggle.setAttribute("aria-expanded", String(!details.hidden));
    });
    document.addEventListener("click", (event) => {
      if (!el.contains(event.target as Node)) close();
    });
    el.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        close();
        toggle.focus();
      }
    });
    const refresh = async () => {
      try {
        const r = await fetch("/api/market");
        if (!r.ok) {
          el.dataset.stale = "true";
          return;
        }
        const data = await r.json();
        el.dataset.stale = data.stale ? "true" : "false";
        for (const q of data.quotes) {
          const item = el.querySelector(`[data-symbol="${q.symbol}"]`);
          if (!item) continue;
          item.querySelector(".market-price")!.textContent =
            "$" + formatter.format(q.price);
          const change = item.querySelector(".market-change")!;
          change.textContent =
            q.change24h === null
              ? "—"
              : (q.change24h > 0 ? "+" : "") +
                formatter.format(q.change24h) +
                "% 24h";
          change.classList.toggle("positive", q.change24h > 0);
          change.classList.toggle("negative", q.change24h < 0);
        }
        if (data.quotes.length) {
          const date = data.quotes
            .map((q: { updatedAt: string }) => q.updatedAt)
            .sort()[0];
          el.querySelector(".market-updated")!.textContent =
            (lang === "es" ? "Actualización: " : "Updated: ") +
            new Date(date).toLocaleString(lang, { timeZone: "UTC" }) +
            " UTC" +
            (data.stale
              ? lang === "es"
                ? " · Último dato válido"
                : " · Last valid data"
              : "");
          for (const item of el.querySelectorAll<HTMLElement>("[data-symbol]"))
            item.title =
              (lang === "es"
                ? "Cotizaciones en USD. Hasta 15 min de retraso. "
                : "USD quotes. Up to 15 min delayed. ") +
              el.querySelector(".market-updated")!.textContent;
        }
      } catch {
        el.dataset.stale = "true";
      }
    };
    setInterval(() => {
      if (!document.hidden) void refresh();
    }, 60 * 1000);
  }
</script>
